{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "allowArbitraryExtensions": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "~": ["./src"],
      "~/*": ["./src/*"],
      "@@": ["."],
      "@@/*": ["./*"],
      "~~": ["."],
      "~~/*": ["./*"],
      "#build/ui": ["./node_modules/.nuxt-ui/ui"],
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"],
      "devlog-ui": ["./packages/devlog-ui/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "wxt.config.ts",
    "auto-imports.d.ts",
    "components.d.ts",
    ".wxt/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", ".output", "packages/**/__tests__", "tests"]
}
